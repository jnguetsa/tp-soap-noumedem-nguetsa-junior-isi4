<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="http://example.com/soap/compte"
           xmlns:tns="http://example.com/soap/compte"
           elementFormDefault="qualified">
    <xs:element name="getCategorieCompteRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="numeroCompte" type="xs:string"/>
                <xs:element name="solde" type="xs:double"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="getCategorieCompteResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="categorie" type="xs:string"/>
                <xs:element name="message" type="xs:string"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

</xs:schema>
